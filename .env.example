# Frontend Environment Variables Example

# Backend REST API base URL (No trailing slash)
# For local development: http://localhost:8000
# For Render backend production deployment: https://your-signal-backend.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket base URL (No trailing slash)
# For local development: ws://localhost:8000
# For Render backend production deployment (WSS): wss://your-signal-backend.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000
